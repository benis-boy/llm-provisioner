{
  "name": "llm-provider",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
    "hostRequirements": { "gpu": "optional" },
  "runArgs": [
    "--gpus=all",
    "--pid=host"
  ],
  "mounts": [
    "source=/mnt/d/AdeptusMechanicus/LLMs,target=/workspaces/llm-provider/LLMs,type=bind",
    "source=llm-provider-opencode-data,target=/home/vscode/.local/share/opencode,type=volume",
    "source=/mnt/c/Users/benja/.local/share/opencode,target=/mnt/host-opencode,type=bind,readonly",
    "source=/proc,target=/host/proc,type=bind,readonly"
  ],
  "postCreateCommand": "bash -ceu 'test -d /home/vscode/.local/share/opencode && test -r /home/vscode/.local/share/opencode && test -w /home/vscode/.local/share/opencode && opencode --version && python3 -m venv .venv && .venv/bin/python -m pip install --editable .'"
}
